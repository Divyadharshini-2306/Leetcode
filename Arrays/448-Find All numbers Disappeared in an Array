class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        int n=nums.length;
        ArrayList<Integer> a = new ArrayList<>();
       boolean[] present = new boolean[n+1];
        for(int i=0;i<nums.length;i++){
           present[nums[i]]=true;
        }
        for(int i=1;i<=n;i++){
            if(!present[i]){
                a.add(i);
            }
        }
        return a;

    }
}
