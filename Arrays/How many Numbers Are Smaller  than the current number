class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {
        int n=nums.length;
        int[] count =new int[n];
        int count1;
        for(int i=0;i<n;i++){
            count1=0;
            for(int j=0;j<n;j++){
                if(nums[i]>nums[j]){
                    count1++;
                }
            }
            count[i]=count1;
        }
        return count;
    }
}
