class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        ArrayList<Integer> l =new ArrayList<>();
        int n=nums.length;
        int k=0;
        int[]  b= new int[n+1];
        for(int i=0;i<n;i++){
            if(b[nums[i]]==1){
                l.add(nums[i]);
            }
            else{
                b[nums[i]]=1;
            }
        }
        
        return l;
    }
}
