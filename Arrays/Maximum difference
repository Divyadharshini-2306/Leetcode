class Solution {
    public int maximumDifference(int[] nums) {
        int n=nums.length;
       int mazz=-1;
      
       for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(nums[i]<nums[j]){
               
                mazz=Math.max(mazz,nums[j]-nums[i]);
            }
            
        }
       }
        return mazz; 
        
    }
}
