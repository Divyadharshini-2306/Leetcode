class Solution {
    public int majorityElement(int[] nums) {
        HashMap<Integer,Integer> map=new HashMap<>();
       
        for(int k:nums){
            map.put(k,(map.getOrDefault(k,0))+1);
        }
        for(int key:map.keySet()){
            map.get(key);
        
        if(map.get(key)>nums.length/2){
            return key;
        }
        }
        return 0;
    }
}
