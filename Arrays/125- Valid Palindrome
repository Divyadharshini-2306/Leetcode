class Solution {
    public boolean isPalindrome(String s) {
        String a =s.toLowerCase();
        int l=0;
        int r=a.length()-1;
        while(l<r){
           
         while(l<r && !Character.isLetterOrDigit(s.charAt(l))){
            l++;
         }
         while(l<r && !Character.isLetterOrDigit(s.charAt(r))){
            r--;
         }
         if(a.charAt(l)!=a.charAt(r)){
            return false;
         }
        l++;
        r--;
            
        }
        return true;
    }
}
