class Solution {
    public int missingNumber(int[] nums) {
        int miss;
        int sum=0;
        int n=nums.length;
        int expected_sum =0;
        expected_sum =n*(n+1)/2;
        for(int i=0;i<nums.length;i++){
            sum+=nums[i];
        }
        miss=expected_sum-sum;
        return miss;
    }
}
