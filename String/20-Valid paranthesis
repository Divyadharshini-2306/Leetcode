class Solution {
    public boolean isValid(String s) {
        Stack<Character> ss= new Stack<>();
        for(char c:s.toCharArray()){
            if(c=='(' ||c=='{' || c=='['){
                ss.push(c);
            }
            else{
                if(ss.isEmpty())return false;
                char t=ss.pop();
                if(c==')' && t!='(')return false;
                if(c=='}'&& t!='{')return false;
                if(c==']' && t!='[')return false;

            }
        }
        return ss.isEmpty();
    }
}
